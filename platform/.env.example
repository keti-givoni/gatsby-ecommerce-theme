# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
# Public base URL of this app (no trailing slash). Used for Grow redirect/notify URLs.
NEXT_PUBLIC_SITE_URL=https://app.your-domain.com
# Comma-separated emails allowed into /admin
ADMIN_EMAILS=you@example.com

# ---- Grow (Meshulam) ----
# sandbox | production
GROW_ENV=sandbox
# The "page code" of a payment page configured in Grow as הוראת קבע (recurring)
GROW_PAGE_CODE=
# Your Grow user id (מזהה משתמש) from the Grow dashboard
GROW_USER_ID=
# API key (מפתח API) from the Grow dashboard, used for approveTransaction / updateRecurringPayment
GROW_API_KEY=
# Monthly price in ILS
PLAN_PRICE_ILS=29
# Human-readable description shown on the Grow payment page
PLAN_DESCRIPTION=מנוי חודשי לפודקאסט עם לבוש מותאם
# How many monthly charges the recurring order runs for (Grow requires a number)
GROW_PAYMENT_NUM=120
# Callback statusCode values Grow sends for a successful charge (comma-separated)
GROW_SUCCESS_STATUS_CODES=2
